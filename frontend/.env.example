# ==============================================================================
# SignalReport Frontend Environment Configuration
# ==============================================================================

# Backend API Base URL
# Option 1 (Direct to Render):
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
# Option 2 (Vercel Proxy Rewrites or Local Dev):
# Leave empty to make same-origin requests to /api/v1/...
VITE_API_BASE_URL=

# Network Request Timeout in milliseconds
# On Render free tier, instances spin down when idle and take ~30-50s to wake up.
# Set to 60000 (60s) to allow cold starts without timing out.
VITE_API_TIMEOUT_MS=60000
