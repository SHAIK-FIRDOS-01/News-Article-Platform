# ==============================================================================
# SignalReport Backend Environment Configuration
# ==============================================================================

# Application & Debug Flags
DEBUG=False
# In production on Render, set ALLOWED_HOSTS to your Render and custom domains:
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Connection URL:
# Defaults to SQLite3 if omitted:
DATABASE_URL=sqlite:///db.sqlite3
# Alternatively for MySQL:
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/signalreport

# Security & Cryptographic Tokens (generate a 32+ character random string)
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters

# Cross-Origin Resource Sharing (CORS) & CSRF Whitelist
# Add your Vercel deployment URL (e.g. "https://your-app.vercel.app")
CORS_ORIGINS=["https://*.vercel.app", "http://localhost:5173", "http://127.0.0.1:5173"]
CSRF_TRUSTED_ORIGINS=["https://*.onrender.com", "https://*.vercel.app"]

# Cookie Security Flags
# For production cross-domain deployment (Vercel frontend calling Render backend):
COOKIE_SECURE=True
COOKIE_SAMESITE=None

# GNews Ingestion Configuration & Quota Budgeting
GNEWS_API_KEY=your_gnews_api_key_here
GNEWS_BASE_URL=https://gnews.io/api/v4
GNEWS_MAX_DAILY_CALLS=80
GNEWS_CATEGORY_COOLDOWN_MINUTES=90
